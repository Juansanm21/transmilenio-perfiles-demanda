# Copiar este archivo a .env y llenar con valores reales.
# .env nunca se sube a GitHub (ver .gitignore).

# PostgreSQL en AWS RDS (capa gratuita): usuario con escritura, lo usa el flujo de Prefect
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SSLMODE=require

# Usuario de solo lectura para Grafana (crearlo aparte del usuario de escritura)
DB_READONLY_USER=
DB_READONLY_PASSWORD=
