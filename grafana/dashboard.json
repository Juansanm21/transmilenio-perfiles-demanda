    {
      "id": 5,
      "type": "table",
      "title": "Ranking de estaciones: dónde y cuándo reforzar",
      "description": "Ordenado por carga sobre el umbral de la franja elegida. La ventana son las horas con al menos 50 % del pico de la estación.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "rds-transmilenio"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 14,
        "h": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "rds-transmilenio"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT puesto AS \"Puesto\", nombre_estacion AS \"Estación\", troncal AS \"Troncal\",\n       MAX(pico_franja) AS \"Pico (val/h)\", MAX(hora_pico) AS \"Hora pico\",\n       MAX(carga_sobre_umbral) AS \"Carga sobre umbral\", MAX(personas_pico) AS \"Personas en el pico\",\n       (MIN(hora) FILTER (WHERE en_ventana_refuerzo))::text || ':00 - ' || (MAX(hora) FILTER (WHERE en_ventana_refuerzo) + 1)::text || ':00' AS \"Ventana de refuerzo\"\nFROM analisis_estacion_hora WHERE semana_inicio = '$semana'::date AND franja = '$franja' AND puesto IS NOT NULL\nGROUP BY puesto, nombre_estacion, troncal ORDER BY puesto"
        }
      ],
