    {
      "id": 7,
      "type": "table",
      "title": "Demanda por hora de las 20 estaciones con más carga (promedio de un día hábil)",
      "description": "Validaciones por hora; más rojo es más demanda. Las celdas que superan 1.000 son las horas de alta presión.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "rds-transmilenio"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 11
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "rds-transmilenio"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH top AS (SELECT cod_estacion, MAX(carga_sobre_umbral) AS c FROM analisis_estacion_hora WHERE semana_inicio = '$semana'::date AND franja = '$franja' AND puesto IS NOT NULL GROUP BY cod_estacion ORDER BY 2 DESC LIMIT 20)\nSELECT a.nombre_estacion AS \"Estación\",\n       ROUND(SUM(a.validaciones_promedio) FILTER (WHERE a.hora = 4)) AS \"4 h\",\n       ROUND(SUM(a.validaciones_promedio) FILTER (WHERE a.hora = 5)) AS \"5 h\",\n       ROUND(SUM(a.validaciones_promedio) FILTER (WHERE a.hora = 6)) AS \"6 h\",\n       ROUND(SUM(a.validaciones_promedio) FILTER (WHERE a.hora = 7)) AS \"7 h\",\n       ROUND(SUM(a.validaciones_promedio) FILTER (WHERE a.hora = 8)) AS \"8 h\",\n       ROUND(SUM(a.validaciones_promedio) FILTER (WHERE a.hora = 9)) AS \"9 h\",\n       ROUND(SUM(a.validaciones_promedio) FILTER (WHERE a.hora = 10)) AS \"10 h\",\n       ROUND(SUM(a.validaciones_promedio) FILTER (WHERE a.hora = 11)) AS \"11 h\",\n       ROUND(SUM(a.validaciones_promedio) FILTER (WHERE a.hora = 12)) AS \"12 h\",\n       ROUND(SUM(a.validaciones_promedio) FILTER (WHERE a.hora = 13)) AS \"13 h\",\n       ROUND(SUM(a.validaciones_promedio) FILTER (WHERE a.hora = 14)) AS \"14 h\",\n       ROUND(SUM(a.validaciones_promedio) FILTER (WHERE a.hora = 15)) AS \"15 h\",\n       ROUND(SUM(a.validaciones_promedio) FILTER (WHERE a.hora = 16)) AS \"16 h\",\n       ROUND(SUM(a.validaciones_promedio) FILTER (WHERE a.hora = 17)) AS \"17 h\",\n       ROUND(SUM(a.validaciones_promedio) FILTER (WHERE a.hora = 18)) AS \"18 h\",\n       ROUND(SUM(a.validaciones_promedio) FILTER (WHERE a.hora = 19)) AS \"19 h\",\n       ROUND(SUM(a.validaciones_promedio) FILTER (WHERE a.hora = 20)) AS \"20 h\",\n       ROUND(SUM(a.validaciones_promedio) FILTER (WHERE a.hora = 21)) AS \"21 h\",\n       ROUND(SUM(a.validaciones_promedio) FILTER (WHERE a.hora = 22)) AS \"22 h\",\n       ROUND(SUM(a.validaciones_promedio) FILTER (WHERE a.hora = 23)) AS \"23 h\"\nFROM analisis_estacion_hora a JOIN top t USING (cod_estacion)\nWHERE a.semana_inicio = '$semana'::date\nGROUP BY a.nombre_estacion, t.c ORDER BY t.c DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 15000,
          "unit": "locale",
          "decimals": 0,
          "color": {
            "mode": "continuous-YlRd"
