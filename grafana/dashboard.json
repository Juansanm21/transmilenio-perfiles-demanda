    {
      "id": 10,
      "type": "timeseries",
      "title": "Evolución del pico de las 5 primeras estaciones, por semana",
      "description": "Pico por hora de la franja elegida en cada semana cargada (la semana de agosto y la de septiembre).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "rds-transmilenio"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "rds-transmilenio"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT semana_inicio::timestamp AS time, nombre_estacion AS metric, MAX(pico_franja) AS value\nFROM analisis_estacion_hora\nWHERE franja = '$franja' AND puesto IS NOT NULL\n  AND cod_estacion IN (SELECT cod_estacion FROM analisis_estacion_hora WHERE semana_inicio = '$semana'::date AND franja = '$franja' AND puesto <= 5)\nGROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "locale",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
